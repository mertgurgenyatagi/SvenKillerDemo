; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sven Killer Demo"
config/description="A psychological walking simulator inspired by Gaspar Noé"
run/main_scene="uid://f1i11lhe2uki"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*uid://ctru81t2dss32"
SettingsManager="*res://scripts/autoload/settings_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
FPSCounter="*res://scenes/ui/fps_counter.tscn"
LocaleManager="*res://scripts/autoload/locale_manager.gd"
CinematicOverlay="*res://scripts/autoload/cinematic_overlay.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="viewport"
window/stretch/aspect="expand"
auto_start=false

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

