{
    "opening_vo": [
        {"start": 2.159, "end": 5.719,  "text": "我喜欢专注在那种感觉本身。"},
        {"start": 7.505, "end": 12.245, "text": "能一下子把它熄灭掉，这件事本身就挺震撼的。"},
        {"start": 13.253, "end": 16.684, "text": "感觉就像是，我也说不清。"},
        {"start": 17.074, "end": 22.884, "text": "像是在一座美丽的海滩上，有鸟儿也有海浪。"},
        {"start": 23.844, "end": 27.062, "text": "那就是它的感觉，我就一直抓着那一点。"}
    ],

    "voicemail": [
        {"start": 0.0,   "end": 1.0,   "text": "嗨，Sven。"},
        {"start": 2.01,  "end": 6.55,  "text": "我打电话给你但你没接。我猜你又睡着了。"},
        {"start": 7.77,  "end": 11.58, "text": "嗯……你爸爸给你打了一点钱。"},
        {"start": 12.88, "end": 14.89, "text": "今天是二十号，对吧。"},
        {"start": 16.67, "end": 22.72, "text": "所以……嗯。如果哪天你需要一些额外的钱，就给我打电话。"},
        {"start": 23.86, "end": 29.67, "text": "你也可以打到家里。大概是 Johan 接电话。"},
        {"start": 29.67, "end": 31.15, "text": "我让 Erika 回家待了几天。"},
        {"start": 31.2,  "end": 37.72, "text": "所以啊。你可以跟你爸爸说，或者直接打他的手机。"},
        {"start": 39.59, "end": 45.09, "text": "总之，他还说了，我知道你不想听这个，"},
        {"start": 46.24, "end": 51.15, "text": "但他想谈谈，也许哪天你可以去公司上班这件事。"},
        {"start": 52.33, "end": 56.25, "text": "我们俩都真的觉得你会很适合那儿。"},
        {"start": 57.32, "end": 62.35, "text": "Karl 很快就要退休了，所以也许……你懂的……"},
        {"start": 63.73, "end": 65.21, "text": "不过，也是吧……我想是这样。"},
        {"start": 66.28, "end": 68.16, "text": "如果需要什么就打电话。"},
        {"start": 69.41, "end": 69.9,  "text": "再见。"}
    ],

    "newspaper": [
        {"start": 0.0,  "end": 4.5,  "text": "两人在林奈大街持刀袭击中身亡"},
        {"start": 5.5,  "end": 12.0, "text": "过去两周里，林奈大街发生了两起分别的持刀袭击事件，造成两人死亡。"},
        {"start": 13.0, "end": 21.0, "text": "首先，一名五十多岁的无家可归男子在深夜被发现倒在室外，伤势严重，随后在医院因伤去世。"},
        {"start": 22.0, "end": 29.5, "text": "本周早些时候，一名据称在该区域乞讨的年轻女孩被发现死在一处楼门口附近。"},
        {"start": 30.5, "end": 37.5, "text": "警方正在调查这些案件，并研究这些事件之间是否存在关联。"},
        {"start": 38.0, "end": 42.5, "text": "但目前尚未逮捕任何嫌疑人。"}
    ],

    "cafe_dialogue": [
        {"start": 1.760,  "end": 8.210,  "text": "我不太理解那种顽固的想法，说我们必须把工作和幸福绑在一起。"},
        {"start": 9.130,  "end": 12.310, "text": "我是说，你只是做点什么来谋生，因为……"},
        {"start": 12.710, "end": 14.720, "text": "你擅长那个，或者说，还算擅长。"},
        {"start": 15.170, "end": 17.810, "text": "好到可以靠它赚钱。"},
        {"start": 18.420, "end": 20.270, "text": "因为这是个消费社会。"},
        {"start": 20.690, "end": 23.240, "text": "你需要钱才能活下去，仅此而已。"},
        {"start": 23.940, "end": 26.810, "text": "而那件事本身不一定非得是给你带来意义的东西。"},
        {"start": 27.710, "end": 29.730, "text": "我小时候大家总是说："},
        {"start": 30.250, "end": 32.190, "text": "你得做一份你热爱的工作。"},
        {"start": 32.900, "end": 33.490, "text": "然后你就会想……"},
        {"start": 34.020, "end": 35.670, "text": "究竟有多少会计，或者……"},
        {"start": 36.080, "end": 38.740, "text": "有多少律师真的热爱自己的工作。"},
        {"start": 39.450, "end": 41.490, "text": "当然，你可以热爱你的工作。"},
        {"start": 41.810, "end": 42.920, "text": "我也喜欢我的工作。"},
        {"start": 43.360, "end": 44.820, "text": "它让我很开心。"},
        {"start": 45.720, "end": 47.670, "text": "但真正给我意义的东西"},
        {"start": 47.980, "end": 50.220, "text": "是像做音乐或者画画那样的事。"},
        {"start": 50.800, "end": 53.520, "text": "而那其实不是同一回事，我也说不太清。"}
    ],

    "penulti_part1": [
        {"start": 1.360,  "end": 5.150,  "text": "你就这么一点点滑进一个角色里，几乎都没意识到。"},
        {"start": 6.280,  "end": 11.570, "text": "你醒来，做该做的事，说该说的话，在该笑的时候笑。"},
        {"start": 12.650, "end": 16.320, "text": "也不算是假。只是……排练多了。"},
        {"start": 17.180, "end": 18.610, "text": "非常非常排练过。"},
        {"start": 19.660, "end": 22.890, "text": "然后突然你就很擅长这一切。几乎太擅长了。"},
        {"start": 24.000, "end": 27.290, "text": "我不是说这很悲惨。它并不悲惨。"},
        {"start": 27.780, "end": 29.470, "text": "它只是……很顺滑。"},
        {"start": 30.230, "end": 30.970, "text": "很熟练。"},
        {"start": 31.870, "end": 33.930, "text": "你开始高效地扮演你自己。"},
        {"start": 34.710, "end": 36.730, "text": "或者，说是某个版本的你自己。"},
        {"start": 38.310, "end": 40.170, "text": "以前我总觉得一切都得紧紧扣在一起。"},
        {"start": 40.950, "end": 44.870, "text": "内心的感受和你外在的行为一定要完全吻合。"},
        {"start": 45.430, "end": 46.400, "text": "否则就是出了问题。"},
        {"start": 47.570, "end": 48.500, "text": "但现在我不太确定了。"},
        {"start": 49.510, "end": 51.730, "text": "也许中间留一点空隙其实也可以。"},
        {"start": 52.500, "end": 53.070, "text": "一小点。"},
        {"start": 53.800, "end": 54.690, "text": "或者大一点。"}
    ],

    "penulti_alley": [],

    "ending_vo": [
        {"start": 1.190,  "end": 2.010,  "text": "所以那是……"},
        {"start": 4.040,  "end": 5.300,  "text": "……呃……"},
        {"start": 5.520,  "end": 6.500,  "text": "……二十七号。"},
        {"start": 6.740,  "end": 8.040,  "text": "不，那是前一周。"},
        {"start": 8.330,  "end": 8.800,  "text": "好。"},
        {"start": 9.910,  "end": 12.220, "text": "然后，你是怎么做的，你就那样走了。"},
        {"start": 12.220, "end": 13.820, "text": "不不，我，嗯……"},
        {"start": 14.770, "end": 19.000, "text": "那里离 Slottsskogen 特别近。所以我就直接去了那边，去了那个沼泽。"},
        {"start": 19.480, "end": 19.980, "text": "好。"},
        {"start": 21.490, "end": 22.110, "text": "嗯……"},
        {"start": 23.540, "end": 25.170, "text": "你之前就计划好了吗。"},
        {"start": 25.170, "end": 25.680, "text": "是的，是的。"},
        {"start": 28.400, "end": 30.420, "text": "其实并不像你们想象的那样。"},
        {"start": 31.560, "end": 33.000, "text": "也不是真的那种冲动控制不住。"},
        {"start": 33.910, "end": 34.760, "text": "只是会觉得很……"},
        {"start": 35.340, "end": 37.100, "text": "那感觉既有趣又让人着迷。"},
        {"start": 38.180, "end": 39.200, "text": "很刺激。"},
        {"start": 39.930, "end": 41.410, "text": "所以你就一直继续做下去。"}
    ]
}
